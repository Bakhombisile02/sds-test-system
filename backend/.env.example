# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ── Database (individual vars — used in development) ─────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sds_test_db
DB_USER=postgres
DB_PASSWORD=

# ── Database (connection string — used in production) ────
# DATABASE_URL=postgres://user:password@host:5432/sds_test_db

# ── Authentication ───────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# ── CORS ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Email (SMTP) ────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@example.com

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE_MAX_SIZE=20m
LOG_FILE_RETENTION_DAYS=14
